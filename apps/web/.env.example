# Obligatoria. Esta Mac y Vercel leen la misma base.
# Postgres de Supabase. Usa el pooler en modo transacción, puerto 6543.
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Datos públicos del proyecto. El navegador solo los usa para entrar con Google.
# PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo en un proyecto vacío, si quieres los fraccionamientos de demostración.
# VIENNA_SEED=1
# VIENNA_DEMO=1
